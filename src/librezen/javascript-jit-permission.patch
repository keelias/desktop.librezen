     }
   },
+
+  refreshJITPermissionToggle() {
+    const toggle = document.getElementById("identity-popup-enable-jit-toggle");
+    const principal = gBrowser.contentPrincipal;
+
+    if (!toggle || !principal || !principal.isContentPrincipal) {
+      return;
+    }
+
+    let siteURI;
+    try {
+      siteURI = Services.io.newURI(principal.siteOriginNoSuffix);
+    } catch (error) {
+      toggle.removeAttribute("pressed");
+      return;
+    }
+
+    const sitePrincipal = Services.scriptSecurityManager.createContentPrincipal(
+      siteURI,
+      principal.originAttributes
+    );
+    const savedPermission = Services.perms.testExactPermissionFromPrincipal(
+      sitePrincipal,
+      LIBREZEN_JIT_PERMISSION
+    );
+
+    let enabled = this._jitEnabledByDefault;
+    if (savedPermission === Services.perms.ALLOW_ACTION) {
+      enabled = true;
+    } else if (savedPermission === Services.perms.DENY_ACTION) {
+      enabled = false;
+    }
+
+    toggle.toggleAttribute("pressed", enabled);
+  },
+
+  toggleJITPermission() {
+    const principal = gBrowser.contentPrincipal;
+    if (!principal || !principal.isContentPrincipal) {
+      return;
+    }
+
+    let siteURI;
+    try {
+      siteURI = Services.io.newURI(principal.siteOriginNoSuffix);
+    } catch (error) {
+      return;
+    }
+
+    const sitePrincipal = Services.scriptSecurityManager.createContentPrincipal(
+      siteURI,
+      principal.originAttributes
+    );
+    const defaultEnabled = this._jitEnabledByDefault;
+    const savedPermission = Services.perms.testExactPermissionFromPrincipal(
+      sitePrincipal,
+      LIBREZEN_JIT_PERMISSION
+    );
+
+    let currentlyEnabled = defaultEnabled;
+    if (savedPermission === Services.perms.ALLOW_ACTION) {
+      currentlyEnabled = true;
+    } else if (savedPermission === Services.perms.DENY_ACTION) {
+      currentlyEnabled = false;
+    }
+
+    const enabled = !currentlyEnabled;
+    if (enabled === defaultEnabled) {
+      Services.perms.removeFromPrincipal(
+        sitePrincipal,
+        LIBREZEN_JIT_PERMISSION
+      );
+    } else {
+      Services.perms.addFromPrincipal(
+        sitePrincipal,
+        LIBREZEN_JIT_PERMISSION,
+        enabled ? Services.perms.ALLOW_ACTION : Services.perms.DENY_ACTION,
+        Services.perms.EXPIRE_NEVER
+      );
+    }
+
+    PanelMultiView.hidePopup(this._identityPopup);
+    this.refreshJITPermissionToggle();
+    BrowserCommands.reload();
+  },
 };
