 }
 
+// Site permissions are evaluated for the top-level site, including when
+// a subframe or worker triggers process selection.
+static bool IsJITEnabledForSiteOrigin(nsIURI* aSiteOriginURI,
+                                      WindowGlobalParent* aParentWindow,
+                                      nsIPrincipal* aPrincipal) {
+  const bool defaultEnabled = StaticPrefs::librezen_jit_enabled_by_default();
+  if (!aSiteOriginURI || !aPrincipal ||
+      !aPrincipal->GetIsContentPrincipal()) {
+    return defaultEnabled;
+  }
+
+  nsCOMPtr<nsIURI> effectiveSiteOriginURI = aSiteOriginURI;
+  if (aParentWindow) {
+    nsAutoCString topSiteOriginNoSuffix;
+    nsresult rv = aParentWindow->TopWindowContext()
+                      ->DocumentPrincipal()
+                      ->GetSiteOriginNoSuffix(topSiteOriginNoSuffix);
+    if (NS_FAILED(rv)) {
+      return defaultEnabled;
+    }
+
+    rv = NS_NewURI(getter_AddRefs(effectiveSiteOriginURI),
+                   topSiteOriginNoSuffix);
+    if (NS_FAILED(rv)) {
+      return defaultEnabled;
+    }
+  }
+
+  nsCOMPtr<nsIPrincipal> sitePrincipal = BasePrincipal::CreateContentPrincipal(
+      effectiveSiteOriginURI, aPrincipal->OriginAttributesRef());
+  if (!sitePrincipal) {
+    return defaultEnabled;
+  }
+
+  RefPtr<PermissionManager> permissionManager =
+      PermissionManager::GetInstance();
+  if (!permissionManager) {
+    return defaultEnabled;
+  }
+
+  uint32_t action = nsIPermissionManager::UNKNOWN_ACTION;
+  nsresult rv = permissionManager->TestExactPermissionFromPrincipal(
+      sitePrincipal, "jit"_ns, &action);
+  if (NS_FAILED(rv)) {
+    return defaultEnabled;
+  }
+
+  if (action == nsIPermissionManager::ALLOW_ACTION) {
+    return true;
+  }
+  if (action == nsIPermissionManager::DENY_ACTION) {
+    return false;
+  }
+  return defaultEnabled;
+}
+
+static bool IsJITEnabledForLoad(nsIPrincipal* aResultPrincipal,
+                                nsIURI* aSiteOriginURI,
+                                WindowGlobalParent* aParentWindow) {
+  if (!AllowJITForSiteOrigin(aSiteOriginURI, aParentWindow)) {
+    return false;
+  }
+  return IsJITEnabledForSiteOrigin(aSiteOriginURI, aParentWindow,
+                                   aResultPrincipal);
+}
+
