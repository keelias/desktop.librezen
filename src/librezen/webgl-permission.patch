+static uint32_t GetWebGLPermission(nsIPrincipal* aPrincipal) {
+  if (!aPrincipal) {
+    return nsIPermissionManager::UNKNOWN_ACTION;
+  }
+
+  if (IsUnrestrictedPrincipal(aPrincipal)) {
+    return nsIPermissionManager::ALLOW_ACTION;
+  }
+
+  nsresult rv;
+  nsCOMPtr<nsIPermissionManager> permissionManager =
+      do_GetService(NS_PERMISSIONMANAGER_CONTRACTID, &rv);
+  NS_ENSURE_SUCCESS(rv, nsIPermissionManager::UNKNOWN_ACTION);
+
+  uint32_t permission = nsIPermissionManager::UNKNOWN_ACTION;
+  rv = permissionManager->TestPermissionFromPrincipal(aPrincipal, "webgl"_ns,
+                                                      &permission);
+  NS_ENSURE_SUCCESS(rv, nsIPermissionManager::UNKNOWN_ACTION);
+
+  return permission;
+}
+
+static bool IsWebGLAllowed_impl(
+    bool webGLPromptEnabled, JSContext* aCx, nsIPrincipal* aPrincipal,
+    const std::function<void(const nsAutoString&)>& aReportToConsole,
+    const std::function<void(bool)>& aTryPrompt) {
+  if (!webGLPromptEnabled) {
+    return true;
+  }
+
+  if (!aCx) {
+    return false;
+  }
+
+  if (IsUnrestrictedPrincipal(aPrincipal)) {
+    return true;
+  }
+
+  nsAutoCString origin;
+  nsresult rv = aPrincipal ? aPrincipal->GetOrigin(origin) : NS_ERROR_FAILURE;
+
+  const uint32_t permission = GetWebGLPermission(aPrincipal);
+  switch (permission) {
+    case nsIPermissionManager::ALLOW_ACTION:
+      return true;
+    case nsIPermissionManager::DENY_ACTION:
+      return false;
+    default:
+      break;
+  }
+
+  bool hidePermissionDoorhanger = StaticPrefs::librewolf_webgl_prompt_hide();
+
+  nsAutoString message;
+  message.AppendPrintf(
+      "Blocked %s from creating WebGL context but prompting the user.",
+      NS_SUCCEEDED(rv) ? origin.get() : "unknown");
+  aReportToConsole(message);
+
+  aTryPrompt(hidePermissionDoorhanger);
+
+  return false;
+}
+
+static bool IsWebGLAllowed(dom::Document* aDocument, JSContext* aCx,
+                           nsIPrincipal* aPrincipal) {
+  if (NS_WARN_IF(!aDocument)) {
+    return false;
+  }
+
+  const bool webGLPromptEnabled = StaticPrefs::librewolf_webgl_prompt();
+
+  if (!webGLPromptEnabled) {
+    return true;
+  }
+
+  auto reportToConsole = [&](const nsAutoString& aMessage) {
+    nsContentUtils::ReportToConsoleNonLocalized(
+        aMessage, nsIScriptError::warningFlag, "Security"_ns, aDocument);
+  };
+
+  auto prompt = [&](bool aHidePermissionDoorhanger) {
+    if (!aPrincipal) {
+      return;
+    }
+
+    nsAutoCString origin;
+    if (NS_FAILED(aPrincipal->GetOrigin(origin))) {
+      return;
+    }
+
+    if (!XRE_IsContentProcess()) {
+      MOZ_ASSERT_UNREACHABLE(
+          "Who's calling this from the parent process without a chrome "
+          "window (it would have been exempt from the RFP targets)?");
+      return;
+    }
+
+    nsPIDOMWindowOuter* window = aDocument->GetWindow();
+    RefPtr<dom::BrowserChild> browserChild = dom::BrowserChild::GetFrom(window);
+    if (!browserChild) {
+      return;
+    }
+
+    browserChild->SendShowWebGLPermissionPrompt(origin,
+                                                aHidePermissionDoorhanger);
+  };
+
+  return IsWebGLAllowed_impl(webGLPromptEnabled, aCx, aPrincipal,
+                             reportToConsole, prompt);
+}
+
+static bool IsWebGLAllowed(dom::OffscreenCanvas* aOffscreenCanvas,
+                           JSContext* aCx, nsIPrincipal* aPrincipal) {
+  if (NS_WARN_IF(!aOffscreenCanvas)) {
+    return false;
+  }
+
+  const bool webGLPromptEnabled = StaticPrefs::librewolf_webgl_prompt();
+
+  if (!webGLPromptEnabled) {
+    return true;
+  }
+
+  Maybe<uint64_t> winId = aOffscreenCanvas->GetWindowID();
+
+  if (winId.isSome() && *winId == UINT64_MAX) {
+    winId = Nothing();
+  }
+
+  auto reportToConsole = [&](const nsAutoString& aMessage) {
+    if (winId.isNothing()) {
+      return;
+    }
+
+    nsContentUtils::ReportToConsoleByWindowID(
+        aMessage, nsIScriptError::warningFlag, "Security"_ns, *winId);
+  };
+
+  nsCString origin;
+  if (!aPrincipal || NS_FAILED(aPrincipal->GetOrigin(origin))) {
+    origin.Truncate();
+  }
+
+  RefPtr<dom::OffscreenCanvas> canvas = aOffscreenCanvas;
+
+  auto prompt = [origin = std::move(origin),
+                 canvas](bool aHidePermissionDoorhanger) {
+    if (origin.IsEmpty()) {
+      return;
+    }
+
+    if (!XRE_IsContentProcess()) {
+      MOZ_ASSERT_UNREACHABLE(
+          "Who's calling this from the parent process without a chrome "
+          "window (it would have been exempt from the RFP targets)?");
+      return;
+    }
+
+    if (NS_IsMainThread()) {
+      nsCOMPtr<nsIGlobalObject> global = canvas->GetRelevantGlobal();
+      if (!global) {
+        return;
+      }
+
+      RefPtr<nsPIDOMWindowInner> window = global->GetAsInnerWindow();
+      if (!window) {
+        return;
+      }
+
+      RefPtr<dom::BrowserChild> browserChild =
+          dom::BrowserChild::GetFrom(window);
+      if (!browserChild) {
+        return;
+      }
+
+      browserChild->SendShowWebGLPermissionPrompt(origin,
+                                                  aHidePermissionDoorhanger);
+      return;
+    }
+
+    if (auto* workerPrivate = dom::GetCurrentThreadWorkerPrivate()) {
+      class WebGLPermissionPromptRunnable final
+          : public dom::WorkerProxyToMainThreadRunnable {
+       public:
+        WebGLPermissionPromptRunnable(const nsCString& aOrigin,
+                                      bool aHidePermissionDoorhanger)
+            : mOrigin(aOrigin),
+              mHidePermissionDoorhanger(aHidePermissionDoorhanger) {}
+
+        // Runnables don't support MOZ_CAN_RUN_SCRIPT, bug 1535398
+        MOZ_CAN_RUN_SCRIPT_BOUNDARY void RunOnMainThread(
+            dom::WorkerPrivate* aWorkerPrivate) override {
+          MOZ_ASSERT(aWorkerPrivate);
+          AssertIsOnMainThread();
+
+          RefPtr<nsPIDOMWindowInner> window =
+              aWorkerPrivate->GetAncestorWindow();
+          RefPtr<dom::BrowserChild> browserChild =
+              dom::BrowserChild::GetFrom(window);
+          if (!browserChild) {
+            return;
+          }
+
+          browserChild->SendShowWebGLPermissionPrompt(
+              mOrigin, mHidePermissionDoorhanger);
+        }
+
+        void RunBackOnWorkerThreadForCleanup(
+            dom::WorkerPrivate* aWorkerPrivate) override {
+          MOZ_ASSERT(aWorkerPrivate);
+          aWorkerPrivate->AssertIsOnWorkerThread();
+        }
+
+       private:
+        nsCString mOrigin;
+        bool mHidePermissionDoorhanger;
+      };
+
+      RefPtr<WebGLPermissionPromptRunnable> runnable =
+          new WebGLPermissionPromptRunnable(origin, aHidePermissionDoorhanger);
+      runnable->Dispatch(workerPrivate);
+    }
+  };
+
+  return IsWebGLAllowed_impl(webGLPromptEnabled, aCx, aPrincipal,
+                             reportToConsole, prompt);
+}
